{
  "name": "@wrpguard/cli",
  "version": "0.1.0-rc.0",
  "description": "Experimental local CLI for WRPGuard: offline preflight of an OpenID4VP 1.0 DCQL query against a caller-supplied scope declaration.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Vynx Labs LLC",
  "homepage": "https://github.com/WRPGuard/wrpguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WRPGuard/wrpguard.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/WRPGuard/wrpguard/issues"
  },
  "type": "module",
  "bin": {
    "wrpguard": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@wrpguard/core": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/clean.mjs dist && tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
